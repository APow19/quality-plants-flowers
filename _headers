# Security & cache headers for Netlify

# HTML pages — revalidate on every request, no legacy headers
/*.html
  Cache-Control: public, no-cache
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self'
  X-XSS-Protection: 0

# Root (index.html served as /)
/
  Cache-Control: public, no-cache
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self'
  X-XSS-Protection: 0

# Versioned CSS & JS — cache aggressively (cache-bust via ?v= query string)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images — long-lived cache
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons & icons
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Manifest & robots — short cache
/site.webmanifest
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
